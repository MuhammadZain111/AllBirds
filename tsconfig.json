{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/components/Button.jsx",
    "app/page.tsx",
    "app/layout.tsx",
    "tailwind.config.js",
    "lib/dbConnect.js",
    "models/UserModel.ts",
    "app/api/get-user/route.js",
    "app/components/ProfileAvatar.jsx",
    "app/not-found.tsx",
    "app/components/ProfileDropdown.jsx",
    "app/components/ValidationItem.jsx"
, "app/AdminComponents/AddProduct.jsx", "app/AdminComponents/AddEmployee.jsx", "app/AdminComponents/AdminProfile.jsx", "app/AdminComponents/AllUsers.jsx", "app/AdminComponents/Header.jsx", "app/AdminComponents/OrdersTable.jsx"  ],
  "exclude": ["node_modules"]
}
